# =====================================================================
# TEMPLATE ENVIRONMENT VARIABLES — Front-end GeoInsight
# File ini hanya contoh/panduan. Salin ke file `.env` lalu isi nilai
# yang sesuai dengan environment Anda (lokal / production).
# JANGAN mengisi nilai rahasia asli di file ini.
# =====================================================================

# URL backend Node.js (Railway)
# Ganti dengan URL Railway Anda
VITE_API_BASE_URL=https://your-backend.up.railway.app

# URL basemap GeoMapid (isikan API key Anda pada {KEY})
VITE_API_GEOMAPID=https://basemap.mapid.io/styles/street-2d-building/style.json?key=YOUR_GEOMAPID_KEY

# ===== Supabase Realtime =====
# Project URL & anon key dari Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_SUPABASE_SCHEMA=public
# Nama tabel yang perlu di-update otomatis (dipisah koma)
VITE_SUPABASE_TABLES=puskesmas_utm,petarisiko_banjirbekasi,jalan_bekasi
